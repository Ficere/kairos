/* 头部信息 */
.header { padding: 32rpx; }
.header-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}
.contract-info { display: flex; align-items: baseline; }
.contract-code { font-size: 40rpx; font-weight: bold; }
.contract-name { color: #7f8c8d; margin-left: 16rpx; }
.price-row { text-align: center; padding-top: 20rpx; border-top: 1rpx solid #ecf0f1; }
.price { font-size: 56rpx; font-weight: bold; color: #2c3e50; }
.price-label { display: block; color: #95a5a6; font-size: 24rpx; margin-top: 8rpx; }

/* 卡片标题 */
.card-title {
  font-weight: bold;
  margin-bottom: 20rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #ecf0f1;
}

/* 评分网格 */
.score-grid { display: flex; justify-content: space-around; }
.score-item { text-align: center; }
.score-value { display: block; font-size: 48rpx; font-weight: bold; color: #3498db; }
.score-value.total { font-size: 64rpx; }
.score-label { font-size: 24rpx; color: #95a5a6; }

/* 信息行 */
.info-row {
  display: flex;
  justify-content: space-between;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f5f6fa;
}
.info-row:last-child { border-bottom: none; }
.info-label { color: #7f8c8d; }
.info-value { font-weight: 500; }
.info-value.stop { color: #e74c3c; }

/* 指标网格 */
.indicator-grid { display: flex; flex-wrap: wrap; }
.indicator-item {
  width: 50%;
  padding: 16rpx 0;
  box-sizing: border-box;
}
.indicator-name { display: block; color: #95a5a6; font-size: 24rpx; }
.indicator-value { display: block; font-size: 32rpx; font-weight: bold; margin-top: 8rpx; }
.indicator-value.highlight { color: #e74c3c; }
.indicator-sub { display: block; color: #7f8c8d; font-size: 24rpx; }

/* 信号列表 */
.signal-list { padding-top: 8rpx; }
.signal-item {
  padding: 12rpx 16rpx;
  background: #f8f9fa;
  border-radius: 8rpx;
  margin-bottom: 12rpx;
  font-size: 26rpx;
}

/* 加载状态 */
.loading {
  text-align: center;
  padding: 100rpx;
  color: #95a5a6;
}
.loading-icon { font-size: 60rpx; margin-bottom: 20rpx; }

