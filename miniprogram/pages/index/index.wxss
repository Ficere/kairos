/* 移仓提示横幅 */
.switch-banner {
  background: linear-gradient(135deg, #f39c12, #e67e22);
  color: white;
  padding: 20rpx 24rpx;
  border-radius: 12rpx;
  margin-bottom: 20rpx;
}
.switch-title { font-weight: bold; margin-bottom: 10rpx; }
.switch-item { font-size: 26rpx; opacity: 0.95; }

/* 筛选栏 */
.filter-bar {
  display: flex;
  background: white;
  border-radius: 12rpx;
  padding: 12rpx;
  margin-bottom: 20rpx;
}
.filter-item {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  border-radius: 8rpx;
  font-size: 26rpx;
  color: #7f8c8d;
}
.filter-item.active {
  background: #3498db;
  color: white;
}
.filter-count { font-size: 22rpx; }

/* 日期栏 */
.date-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
  font-size: 26rpx;
  color: #7f8c8d;
}
.date-picker {
  display: flex;
  align-items: center;
  background: #ecf0f1;
  padding: 10rpx 20rpx;
  border-radius: 8rpx;
}
.picker-arrow { margin-left: 10rpx; font-size: 20rpx; }
.refresh-hint { font-size: 22rpx; }

/* 加载中 */
.loading {
  text-align: center;
  padding: 100rpx;
  color: #95a5a6;
}
.loading-icon { font-size: 60rpx; margin-bottom: 20rpx; }

/* 空状态 */
.empty-hint { font-size: 24rpx; margin-top: 10rpx; }

/* 结果列表 */
.result-item {
  background: white;
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
}
.result-item.switching { border-left: 6rpx solid #f39c12; }

.item-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}
.item-contract { display: flex; align-items: center; }
.status-icon { margin-right: 8rpx; }
.contract-name { font-weight: bold; font-size: 32rpx; }
.variety-name { color: #7f8c8d; margin-left: 12rpx; font-size: 26rpx; }

.item-body {
  display: flex;
  flex-wrap: wrap;
  border-top: 1rpx solid #ecf0f1;
  border-bottom: 1rpx solid #ecf0f1;
  padding: 16rpx 0;
}
.item-row {
  width: 50%;
  display: flex;
  justify-content: space-between;
  padding: 8rpx 0;
}
.label { color: #95a5a6; font-size: 26rpx; }
.value { font-size: 26rpx; }
.value.score { color: #3498db; font-weight: bold; }
.value.highlight { color: #e74c3c; }

.item-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 16rpx;
}
.confidence { color: #7f8c8d; font-size: 24rpx; }
.arrow { color: #bdc3c7; font-size: 36rpx; }

