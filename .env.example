# Kairos 环境变量配置示例
# 复制此文件为 .env 并填入你的实际值
# cp .env.example .env

# =============================================================================
# 数据源配置
# =============================================================================

# Tushare API Token（可选）
# 用于获取期货历史数据，数据质量高于免费数据源
# 获取方式：https://tushare.pro/ 注册后在个人中心获取
# 未配置时自动使用新浪财经免费数据源
TUSHARE_TOKEN=your_tushare_token_here

# =============================================================================
# AI 分析配置
# =============================================================================

# Perplexity API Key（可选）
# 用于宏观面和基本面深度分析
# 获取方式：https://www.perplexity.ai/settings/api
# 配置后 kairos-analyze --all 会自动调用 Perplexity 进行宏观分析
PERPLEXITY_API_KEY=pplx-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

